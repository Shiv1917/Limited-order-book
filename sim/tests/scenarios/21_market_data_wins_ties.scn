# Our order and a historical add share a timestamp: market data goes first,
# so D is ahead of us and its execution does not fill us.
[config]
{"strategy": {"actions": [{"t": "34200.000000002", "side": "buy", "price": 100000, "qty": 20}]}}
[messages]
34200.000000001,1,1,10,100100,-1
34200.000000002,1,4,40,100000,1
34200.000000003,4,4,40,100000,1
[expected]
34200.000000002,0,acked,buy,100000,20,
