# We take 150 of 200. History then executes 100 of that order: those are the
# shares we already took, so own_taken drops to 50 and 50 remain for us.
[config]
{"strategy": {"actions": [
  {"t": "34200.000000003", "side": "buy", "price": 100100, "qty": 150, "type": "ioc"},
  {"t": "34200.000000005", "side": "buy", "price": 100100, "qty": 100, "type": "ioc"}]},
 "risk": {"max_order_size": 1000}}
[messages]
34200.000000001,1,1,100,100000,1
34200.000000002,1,2,200,100100,-1
34200.000000004,4,2,100,100100,-1
34200.000000100,1,999,1,90000,1
[expected]
34200.000000003,0,acked,buy,100100,150,
34200.000000003,0,filled,buy,100100,150,taker
34200.000000005,1,acked,buy,100100,100,
34200.000000005,1,partial,buy,100100,50,taker
34200.000000005,1,cancelled,buy,100100,50,unfilled
